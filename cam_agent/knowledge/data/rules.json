{
 "_source": "sql_database",
 "_comment": "Quantitative constraints loaded into an in-memory SQLite table 'rules'. material_group '*' applies to all; groups: aluminum, steel, stainless, cast iron, titanium, superalloy, hardened steel, copper alloy, polymer.",
 "rules": [
  {
   "rule_id": "H-001",
   "feature_type": "hole",
   "material_group": "*",
   "parameter": "diameter",
   "min_value": 1.0,
   "max_value": 100.0,
   "unit": "mm",
   "severity": "critical",
   "standard": "shop capability",
   "message": "Drilled/bored holes between 1 mm and 100 mm with the available tooling."
  },
  {
   "rule_id": "H-002",
   "feature_type": "hole",
   "material_group": "aluminum",
   "parameter": "depth_to_diameter",
   "min_value": 0,
   "max_value": 8.0,
   "unit": "ratio",
   "severity": "warning",
   "standard": "DFM guideline",
   "message": "Above 8xD in aluminium needs a long drill, pecking and through-coolant."
  },
  {
   "rule_id": "H-003",
   "feature_type": "hole",
   "material_group": "steel",
   "parameter": "depth_to_diameter",
   "min_value": 0,
   "max_value": 5.0,
   "unit": "ratio",
   "severity": "warning",
   "standard": "DFM guideline",
   "message": "Above 5xD in steel: 8xD carbide drill with through-coolant or peck cycle."
  },
  {
   "rule_id": "H-004",
   "feature_type": "hole",
   "material_group": "stainless",
   "parameter": "depth_to_diameter",
   "min_value": 0,
   "max_value": 3.0,
   "unit": "ratio",
   "severity": "warning",
   "standard": "DFM guideline",
   "message": "Above 3xD in stainless: parabolic-flute drill, peck cycle, high-pressure coolant."
  },
  {
   "rule_id": "H-005",
   "feature_type": "hole",
   "material_group": "titanium",
   "parameter": "depth_to_diameter",
   "min_value": 0,
   "max_value": 3.0,
   "unit": "ratio",
   "severity": "warning",
   "standard": "DFM guideline",
   "message": "Above 3xD in titanium: through-coolant carbide drill; above 10xD gun drilling."
  },
  {
   "rule_id": "H-006",
   "feature_type": "hole",
   "material_group": "superalloy",
   "parameter": "depth_to_diameter",
   "min_value": 0,
   "max_value": 3.0,
   "unit": "ratio",
   "severity": "warning",
   "standard": "DFM guideline",
   "message": "Above 3xD in nickel alloys: through-coolant carbide drill, low feed."
  },
  {
   "rule_id": "H-007",
   "feature_type": "hole",
   "material_group": "cast iron",
   "parameter": "depth_to_diameter",
   "min_value": 0,
   "max_value": 6.0,
   "unit": "ratio",
   "severity": "warning",
   "standard": "DFM guideline",
   "message": "Above 6xD in cast iron: peck for chip evacuation."
  },
  {
   "rule_id": "H-008",
   "feature_type": "hole",
   "material_group": "hardened steel",
   "parameter": "depth_to_diameter",
   "min_value": 0,
   "max_value": 2.5,
   "unit": "ratio",
   "severity": "warning",
   "standard": "DFM guideline",
   "message": "Holes in hardened steel above 2.5xD: drill before hardening or EDM."
  },
  {
   "rule_id": "H-010",
   "feature_type": "hole",
   "material_group": "*",
   "parameter": "tolerance_it_grade",
   "min_value": 6,
   "max_value": 13,
   "unit": "IT",
   "severity": "warning",
   "standard": "ISO 286-1",
   "message": "Drilling holds IT10-IT12; reaming IT7-IT8; boring IT6-IT7. Tighter grades need grinding/honing."
  },
  {
   "rule_id": "H-011",
   "feature_type": "hole",
   "material_group": "*",
   "parameter": "min_wall_thickness",
   "min_value": 1.5,
   "max_value": 1000000000.0,
   "unit": "mm",
   "severity": "warning",
   "standard": "DFM guideline",
   "message": "Wall between a hole and an edge >= 1.5 mm (>= 0.5xD preferred)."
  },
  {
   "rule_id": "T-001",
   "feature_type": "thread",
   "material_group": "*",
   "parameter": "thread_engagement_x_d",
   "min_value": 1.0,
   "max_value": 3.0,
   "unit": "xD",
   "severity": "warning",
   "standard": "ISO 965 / VDI 2230",
   "message": "Engagement 1.0xD steel, 1.5xD cast iron, 2xD aluminium/soft materials; > 3xD adds nothing."
  },
  {
   "rule_id": "T-002",
   "feature_type": "thread",
   "material_group": "*",
   "parameter": "tap_drill_clearance_x_pitch",
   "min_value": 0.5,
   "max_value": 1.2,
   "unit": "x pitch",
   "severity": "critical",
   "standard": "ISO 2306",
   "message": "Tap drill = nominal - pitch (about 75 % thread height)."
  },
  {
   "rule_id": "T-004",
   "feature_type": "thread",
   "material_group": "*",
   "parameter": "blind_bottom_clearance_x_pitch",
   "min_value": 2.0,
   "max_value": 1000000000.0,
   "unit": "x pitch",
   "severity": "warning",
   "standard": "DIN 76-1",
   "message": "Blind tapped hole: drill at least 2-3 pitches deeper than the full thread (thread run-out)."
  },
  {
   "rule_id": "P-001",
   "feature_type": "pocket",
   "material_group": "*",
   "parameter": "corner_radius",
   "min_value": 0.5,
   "max_value": 1000000000.0,
   "unit": "mm",
   "severity": "critical",
   "standard": "DFM guideline",
   "message": "Internal vertical corners need a radius (>= smallest endmill radius); sharp corners need EDM."
  },
  {
   "rule_id": "P-002",
   "feature_type": "pocket",
   "material_group": "*",
   "parameter": "depth_to_width",
   "min_value": 0,
   "max_value": 4.0,
   "unit": "ratio",
   "severity": "warning",
   "standard": "DFM guideline",
   "message": "Pocket depth > 4x narrowest width: long-reach tools, reduced ap/ae."
  },
  {
   "rule_id": "P-003",
   "feature_type": "pocket",
   "material_group": "*",
   "parameter": "min_width",
   "min_value": 1.0,
   "max_value": 1000000000.0,
   "unit": "mm",
   "severity": "critical",
   "standard": "shop capability",
   "message": "Narrowest pocket width must exceed the smallest endmill (2 mm in the library)."
  },
  {
   "rule_id": "P-004",
   "feature_type": "pocket",
   "material_group": "*",
   "parameter": "corner_radius_to_depth",
   "min_value": 0.1,
   "max_value": 1000000000.0,
   "unit": "ratio",
   "severity": "warning",
   "standard": "DFM guideline",
   "message": "Corner radius >= 1/10 of the pocket depth (tool stick-out <= 5xD)."
  },
  {
   "rule_id": "S-001",
   "feature_type": "slot",
   "material_group": "*",
   "parameter": "width",
   "min_value": 1.0,
   "max_value": 1000000000.0,
   "unit": "mm",
   "severity": "critical",
   "standard": "shop capability",
   "message": "Slot width must exceed the smallest available endmill."
  },
  {
   "rule_id": "S-002",
   "feature_type": "slot",
   "material_group": "*",
   "parameter": "depth_to_width",
   "min_value": 0,
   "max_value": 3.0,
   "unit": "ratio",
   "severity": "warning",
   "standard": "DFM guideline",
   "message": "Slots deeper than 3x width: several depth passes, trochoidal milling."
  },
  {
   "rule_id": "F-001",
   "feature_type": "planar_face",
   "material_group": "*",
   "parameter": "flatness",
   "min_value": 0.02,
   "max_value": 1000000000.0,
   "unit": "mm",
   "severity": "warning",
   "standard": "ISO 1101",
   "message": "Face milling holds about 0.02 mm flatness per 100 mm; tighter needs grinding or lapping."
  },
  {
   "rule_id": "F-002",
   "feature_type": "planar_face",
   "material_group": "*",
   "parameter": "surface_finish_ra",
   "min_value": 0.4,
   "max_value": 1000000000.0,
   "unit": "um",
   "severity": "warning",
   "standard": "ISO 21920-2",
   "message": "Milling reaches Ra 0.4-3.2 um (fine finishing); below 0.4 um needs grinding/polishing."
  },
  {
   "rule_id": "C-001",
   "feature_type": "chamfer",
   "material_group": "*",
   "parameter": "size",
   "min_value": 0.1,
   "max_value": 10.0,
   "unit": "mm",
   "severity": "warning",
   "standard": "ISO 13715",
   "message": "Chamfers 0.1-10 mm with a 90 deg chamfer mill; larger by profiling. Undefined edges: break 0.1-0.3 mm (ISO 13715)."
  },
  {
   "rule_id": "R-001",
   "feature_type": "fillet",
   "material_group": "*",
   "parameter": "radius",
   "min_value": 0.3,
   "max_value": 25.0,
   "unit": "mm",
   "severity": "warning",
   "standard": "shop capability",
   "message": "External fillets with ball or corner-radius endmills 0.3-25 mm."
  },
  {
   "rule_id": "B-001",
   "feature_type": "boss",
   "material_group": "*",
   "parameter": "height_to_diameter",
   "min_value": 0,
   "max_value": 4.0,
   "unit": "ratio",
   "severity": "warning",
   "standard": "DFM guideline",
   "message": "Tall bosses (> 4x diameter) deflect during profiling."
  },
  {
   "rule_id": "G-001",
   "feature_type": "*",
   "material_group": "*",
   "parameter": "min_wall_thickness",
   "min_value": 0.8,
   "max_value": 1000000000.0,
   "unit": "mm",
   "severity": "warning",
   "standard": "DFM guideline",
   "message": "Metal walls thinner than 0.8-1 mm chatter and deflect (plastics: 1.5 mm)."
  },
  {
   "rule_id": "G-002",
   "feature_type": "*",
