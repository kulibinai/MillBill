#8163 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#8164 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-03),#8161,
  'distance_accuracy_value','confusion accuracy');
#8165 = PRODUCT_RELATED_PRODUCT_CATEGORY('part',$,(#7));
ENDSEC;
END-ISO-10303-21;
